# =============================================================================
# COPY THIS FILE TO .env AND FILL IN THE PLACEHOLDERS
# Never commit real secrets. .env is gitignored.
# Authoritative contract: docs/ops/environment-contract.md
# =============================================================================


# -----------------------------------------------------------------------------
# WEB — required in production (NODE_ENV=production)
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# Partner Dashboard → App → Client credentials
SHOPIFY_API_KEY=CLIENT_ID
SHOPIFY_API_SECRET=CLIENT_SECRET

# Must align with shopify.app.upselltrix.toml [access_scopes]
SCOPES=read_discounts,write_discounts,read_publications,read_products

# Local: Shopify CLI tunnel overwrites when automatically_update_urls_on_dev=true
# Production/staging: real HTTPS origin (NOT example.com / localhost)
SHOPIFY_APP_URL=YOUR_TUNNEL_OR_HTTPS_ORIGIN

# PostgreSQL only (not file: SQLite). Local Docker is optional — any reachable Postgres works.
# Staging: use a dedicated remote database URL (Neon/RDS/Supabase/etc.), never production.
DATABASE_URL=postgresql://fgpb:fgpb@localhost:5432/fgpb?schema=public

# Staging Shopify origin (HTTPS). Used by config:staging:generate / validate.
# STAGING_SHOPIFY_APP_URL=https://staging.your-domain.tld
# PRODUCTION_SHOPIFY_APP_HOST=app.your-domain.tld

# Temporary only — documented API version skew override for release gates:
# ALLOW_SHOPIFY_API_VERSION_SKEW=1


# -----------------------------------------------------------------------------
# WORKER — same Shopify + DATABASE_URL as web; knobs optional (safe defaults)
# See docs/ops/worker-scheduling.md
# -----------------------------------------------------------------------------

# DISCOUNT_SYNC_BATCH=10
# DISCOUNT_SYNC_BASE_DELAY_MS=1000
# DISCOUNT_SYNC_MAX_DELAY_MS=1800000
# DISCOUNT_SYNC_MAX_ATTEMPTS=8
# DISCOUNT_SYNC_LEASE_MS=60000
# DISCOUNT_SYNC_POLL_MS=5000
# DISCOUNT_SYNC_SHUTDOWN_GRACE_MS=25000
# DISCOUNT_SYNC_LOCK_TIMEOUT_MS=30000
# DISCOUNT_SYNC_WORKER_DISABLED=false


# -----------------------------------------------------------------------------
# OPTIONAL
# -----------------------------------------------------------------------------

# SHOP_CUSTOM_DOMAIN=shops.example.com
# SHOPIFY_TOML_PATH=shopify.app.production.toml
# SHOPIFY_TOML_OUT=shopify.app.production.toml
