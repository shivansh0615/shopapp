{
  "name": "free-gift-progress-bar",
  "version": "0.1.0-private-beta",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy --config release",
    "validate:env": "node --import tsx scripts/validate-env.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "check:api-version-skew": "node scripts/check-api-version-skew.mjs",
    "docker-start": "npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test:backend": "node scripts/test-app.mjs backend",
    "test:compliance": "node scripts/test-app.mjs compliance",
    "test:promotion": "node scripts/test-app.mjs promotion",
    "test:discount-function": "npm test --workspace fgpb-discount",
    "test:storefront": "npm test --workspace free-gift-progress-bar-extension",
    "test:discount-sync": "node --import tsx --test app/lib/discount-sync-config.server.test.ts app/lib/shop-lock.server.test.ts app/services/discount-sync.server.test.ts app/services/discount-sync-job.server.test.ts app/services/discount-sync-worker.server.test.ts app/services/campaign-schedule-sync.server.test.ts app/services/discount-sync-checkpoint.server.test.ts app/services/uninstall-deactivation.server.test.ts",
    "test": "npm run test:backend && npm run test:compliance && npm run test:promotion && npm run test:discount-function && npm run test:storefront",
    "build:storefront": "npm run build --workspace free-gift-progress-bar-extension",
    "build:docker": "docker build -t fgpb-app:local .",
    "discount-sync:process": "node --import tsx scripts/discount-sync-process.mjs",
    "discount-sync:once": "node --import tsx scripts/discount-sync-once.mjs",
    "discount-sync:inspect": "node --import tsx scripts/discount-sync-inspect.mjs",
    "discount-sync:watch": "node --import tsx scripts/discount-sync-process.mjs --watch",
    "test:money": "node --import tsx --test app/lib/money/money.test.ts app/lib/money/legacy-float.test.ts",
    "money:backfill": "node --import tsx scripts/money-backfill.mjs --execute",
    "money:backfill:dry-run": "node --import tsx scripts/money-backfill.mjs --dry-run",
    "money:verify": "node --import tsx scripts/money-backfill-verify.mjs",
    "validate:production-toml": "node scripts/validate-production-toml.mjs",
    "generate:production-toml": "node scripts/generate-production-toml.mjs",
    "validate:production-config": "npm run validate:env && npm run validate:production-toml",
    "deploy:production": "node scripts/deploy-production.mjs",
    "check:deployment-readiness": "node scripts/check-deployment-readiness.mjs",
    "db:check": "node --import tsx scripts/db-check.mjs",
    "staging:fixtures:seed": "node --import tsx scripts/staging-money-fixtures.mjs --seed",
    "staging:fixtures:cleanup": "node --import tsx scripts/staging-money-fixtures.mjs --cleanup",
    "config:staging:generate": "node scripts/generate-staging-toml.mjs",
    "config:staging:validate": "node scripts/validate-staging-toml.mjs",
    "deploy:staging": "node scripts/deploy-staging.mjs",
    "test:config": "node --import tsx --test app/env.server.test.ts scripts/validate-production-toml.test.mjs scripts/generate-production-toml.test.mjs",
    "test:storefront-validation": "node --test scripts/storefront-validation/helpers.test.mjs",
    "validate:storefront-integration": "node scripts/storefront-validation/run.mjs",
    "check:release": "npm run build:storefront && npm run check:storefront-assets && npm run check:deployment-readiness && npm run scan:secrets && npm run test:config && npx prisma format --check && npx prisma validate && npx prisma generate && npm run test:money && npm run typecheck && npm run lint && npm run test:backend && npm run test:compliance && npm run test:promotion && npm run test:discount-sync && npm run test:discount-function && npm run test:storefront && npm run test:storefront-validation && npm run build",
    "predeploy": "npm run build:storefront && npm run check:storefront-assets && node scripts/validate-upselltrix-release.mjs",
    "check:storefront-assets": "node scripts/storefront-assets.mjs --check"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@react-router/dev": "^7.12.0",
    "@react-router/fs-routes": "^7.12.0",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@shopify/shopify-app-react-router": "^1.1.0",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "isbot": "^5.1.31",
    "pg": "^8.22.0",
    "prisma": "^6.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.12.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^1.2.0",
    "@shopify/polaris-types": "^1.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.18.8",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "graphql-config": "^5.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vite": "^6.3.6"
  },
  "workspaces": [
    "extensions/*",
    "storefront-extension"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0"
  },
  "author": "Deep"
}
